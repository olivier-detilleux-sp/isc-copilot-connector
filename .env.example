# Copy this file to .env.local and fill the values.
# .env.local is gitignored. Do not commit the client secret.

# Entra ID tenant (GUID)
AZURE_TENANT_ID=

# App registration used as a Dataverse application user
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Dataverse Web API host of the Copilot Studio environment (no trailing slash)
DATAVERSE_URL=https://orgc563e116.api.crm4.dynamics.com

# Leave empty to reuse AZURE_CLIENT_ID / AZURE_CLIENT_SECRET for Microsoft Graph.
# Set these only if group lookup uses a different app registration.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
